{
  "name": "@householdrebates/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -r src/migrations dist/migrations && mkdir -p dist/alerts && cp -r src/alerts/migrations dist/alerts/migrations",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/alerts/cli/migrate.ts",
    "deliver": "tsx src/cli/deliver.ts",
    "withdraw": "tsx src/cli/withdraw.ts",
    "export": "tsx src/cli/export.ts",
    "erase": "tsx src/cli/erase.ts",
    "purge": "tsx src/cli/purge.ts",
    "status": "tsx src/cli/status.ts",
    "mail-test": "tsx src/cli/mail-test.ts",
    "alerts:draft": "tsx src/alerts/cli/draft.ts",
    "alerts:send": "tsx src/alerts/cli/send.ts",
    "alerts:unsubscribe": "tsx src/alerts/cli/unsubscribe.ts",
    "alerts:export": "tsx src/alerts/cli/export.ts",
    "alerts:erase": "tsx src/alerts/cli/erase.ts",
    "alerts:stats": "tsx src/alerts/cli/stats.ts",
    "alerts:purge": "tsx src/alerts/cli/purge.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "better-sqlite3": "^13.1.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
