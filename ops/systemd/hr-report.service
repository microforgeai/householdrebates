[Unit]
Description=Household Rebates weekly GoAccess and AI log report
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=hr-reports
UMask=0027
ExecStart=/usr/local/libexec/householdrebates/weekly-report.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/householdrebates
ReadOnlyPaths=/var/log/nginx
