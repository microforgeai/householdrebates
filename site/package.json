{
  "name": "@householdrebates/site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-llms.mjs && node scripts/check-answers.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "import:urlmap": "node scripts/import-url-map.mjs",
    "check": "node scripts/check-figures.mjs && node scripts/check-copy.mjs && node scripts/check-consent-hash.mjs && node scripts/check-installers.mjs && node scripts/check-legal.mjs && astro check",
    "check:sources": "node scripts/check-sources.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.11",
    "typescript": "^5.7.3",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "vitest": "^5.1.0"
  }
}
