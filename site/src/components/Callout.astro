---
export interface Props {
  type?: 'info' | 'caution' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;
---

<aside class={`callout callout--${type}`} role="note">
  {title && <strong class="callout__title">{title}</strong>}
  <div class="callout__body">
    <slot />
  </div>
</aside>
