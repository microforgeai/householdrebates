---
import { getCollection } from 'astro:content';
import AlertSignup from './AlertSignup.astro';
import Checker from './Checker.astro';
import type { CheckerBootstrapPayload } from './CheckerApp';
import { assertFigureNotStale } from '../lib/dates';
import { formatAud, formatFigureAmount, KIND_TAGS, type FigureData } from '../lib/figures';
import { getEnabledUrls } from '../lib/rollout';
import { resolveElectionWatchNotice } from '../lib/rule-status';
import {
  FIELDS_META,
  LINKS_DATA,
  MESSAGES,
  RULES,
  RULES_META,
  getCheckerReferencedFigureIds,
  loadSolsticePostcodesFromRow53,
  type SourceMeta,
} from '../lib/checker';
import { buildCompactPostcodeArtifact } from '../lib/checker/postcode-compact';

export interface Props {
  state?: 'vic';
}

const maxAgeDays = Number(process.env.MAX_FIGURE_AGE_DAYS || 45);
const postcodesArtifact = buildCompactPostcodeArtifact();
const checkerFigIds = new Set(getCheckerReferencedFigureIds());

const allFigures = await getCollection('figures', (f) => checkerFigIds.has(f.id));
const allSources = await getCollection('sources');
const sourceEntryById = new Map(allSources.map((s) => [s.id, s]));

const referencedSourceIds = new Set<string>(['energyvic-businesses']);
for (const rule of RULES) {
  for (const sid of rule.sourceIds) {
    referencedSourceIds.add(sid);
  }
}

const serializedFigures: FigureData[] = allFigures.map((f) => {
  assertFigureNotStale(`figure:${f.id}`, f.data.checkedOn, maxAgeDays);
  const srcId = typeof f.data.sourceId === 'string' ? f.data.sourceId : f.data.sourceId.id;
  referencedSourceIds.add(srcId);
  return {
    id: f.data.id,
    group: f.data.group,
    state: f.data.state,
    program: f.data.program,
    activity: f.data.activity,
    audience: f.data.audience,
    jurisdiction: f.data.jurisdiction,
    scenario: f.data.scenario,
    qualifier: f.data.qualifier,
    unit: f.data.unit,
    display: f.data.display,
    basis: f.data.basis,
    kind: f.data.kind,
    method: f.data.method,
    amountMin: f.data.amountMin,
    amountMax: f.data.amountMax,
    currency: f.data.currency,
    gstIncluded: f.data.gstIncluded,
    sourceId: srcId,
    checkedOn: f.data.checkedOn.toISOString().slice(0, 10),
    formatted: formatFigureAmount(f.data),
    amountText: formatAud(f.data.amountMax, f.data.display ?? 'standard'),
  };
});

const electionNotice = resolveElectionWatchNotice();
referencedSourceIds.add(electionNotice.sourceId);

const electionSourceEntry = sourceEntryById.get(electionNotice.sourceId);
if (!electionSourceEntry) {
  throw new Error(`EligibilityChecker missing election source "${electionNotice.sourceId}"`);
}
assertFigureNotStale(
  `source:${electionNotice.sourceId}`,
  electionSourceEntry.data.checkedOn,
  maxAgeDays,
);

const serializedSources: SourceMeta[] = [];
for (const sid of referencedSourceIds) {
  const entry = sourceEntryById.get(sid);
  if (!entry) {
    throw new Error(`EligibilityChecker missing referenced source "${sid}"`);
  }
  serializedSources.push({
    id: entry.id,
    title: entry.data.title,
    publisher: entry.data.publisher,
    url: entry.data.url,
    official: Boolean(entry.data.official),
    checkedOn: entry.data.checkedOn.toISOString().slice(0, 10),
  });
}

const serializedFiguresMap = new Map(serializedFigures.map((f) => [f.id, f]));
const incomeCapStr = serializedFiguresMap.get('vic-solar-homes-income-cap')?.amountText;
const propertyCapStr = serializedFiguresMap.get('vic-solar-homes-property-cap')?.amountText;
const serializedFields = FIELDS_META.map((field) => {
  if (field.id === 'SH1' && incomeCapStr) {
    return { ...field, label: `Is the combined taxable income of all owners under ${incomeCapStr} a year?` };
  }
  if (field.id === 'SH2' && propertyCapStr) {
    return { ...field, label: `Is the property worth less than ${propertyCapStr}?` };
  }
  return field;
});

const bootstrapPayload: CheckerBootstrapPayload = {
  postcodesUrl: postcodesArtifact.url,
  figures: serializedFigures,
  kindTags: KIND_TAGS,
  sources: serializedSources,
  enabledUrls: [...getEnabledUrls()],
  solsticePostcodes: loadSolsticePostcodesFromRow53(),
  catalog: {
    rules: [...RULES_META],
    fields: serializedFields,
    messages: [...MESSAGES],
    links: LINKS_DATA,
  },
  electionNotice: {
    visible: electionNotice.visible,
    message: electionNotice.message,
    sourceUrl: electionSourceEntry.data.url,
    sourcePublisher: electionSourceEntry.data.publisher,
    checkedOnFormatted: electionNotice.checkedOnFormatted,
  },
};
---

<section
  class="checker-card"
  id="eligibility-checker"
  aria-labelledby="checker-heading"
  data-checker-root
>
  <h2 id="checker-heading">Check your Victorian upgrade eligibility</h2>
  <p>
    Answer one step at a time for your home or business to see which Victorian Energy Upgrades (VEU) discounts, Solar Homes rebates, and federal battery discounts match your postcode and appliances. Your answers stay in your browser and nothing is sent anywhere.
  </p>

  <noscript>
    <p class="callout callout--caution" data-checker-noscript>
      This interactive eligibility checker runs in your browser and needs JavaScript turned on. Without JavaScript, use the upgrade guide directory below to read the household and business rules directly.
    </p>
  </noscript>

  <script
    type="application/json"
    id="checker-bootstrap"
    set:html={JSON.stringify(bootstrapPayload)}
  />

  <Checker />
  {process.env.PUBLIC_ALERTS_ENABLED === 'true' && (
    <div data-checker-alert-mount hidden>
      <AlertSignup placement="checker" />
    </div>
  )}
</section>
