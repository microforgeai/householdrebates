---
import { getCollection } from 'astro:content';
import { formatAuDate } from '../lib/dates';
import { RESULT_LINKS } from '../data/eligibility/result-links';
import postcodesJson from '../data/postcodes.json';

export interface Props {
  state?: 'vic';
}

const allFigures = await getCollection('figures');
const allSources = await getCollection('sources');
const sourceById = new Map(allSources.map((s) => [s.id, s.data]));

const serializedFigures = allFigures
  .filter((f) => f.data.audience === 'household' && !f.data.effectiveTo)
  .map((f) => {
    const srcId = typeof f.data.sourceId === 'string' ? f.data.sourceId : f.data.sourceId.id;
    const src = sourceById.get(srcId);
    return {
      ...f.data,
      sourceId: srcId,
      checkedOn: formatAuDate(f.data.checkedOn),
      sourceUrl: src?.url,
      sourceTitle: src?.title,
    };
  });

const compactPostcodes: Record<string, string> = {};
for (const [pc, row] of Object.entries(postcodesJson.rows)) {
  const areaChar = row.area === 'Metropolitan' ? 'M' : 'R';
  const gasChar = row.reticulatedGas ? '1' : '0';
  const climChar = row.climaticRegion === 'Mild' ? 'M' : row.climaticRegion === 'Cold' ? 'C' : 'H';
  compactPostcodes[pc] = `${areaChar}${gasChar}${climChar}${row.hpZone}`;
}

const resolvedLinks = Object.fromEntries(
  Object.entries(RESULT_LINKS).map(([key, entry]) => {
    const src = sourceById.get(entry.external.sourceId);
    return [
      key,
      {
        internal: entry.internal,
        externalUrl: src?.url ?? 'https://www.energy.vic.gov.au/victorian-energy-upgrades',
        externalLabel: src?.title ?? 'Energy Victoria',
      },
    ];
  }),
);
---

<section
  class="checker-card"
  id="eligibility-checker"
  aria-labelledby="checker-heading"
  data-checker-root
>
  <h2 id="checker-heading">Check your VEU upgrade scenario</h2>
  <p>
    Answer the questions below to see which Victorian Energy Upgrades (VEU) scenario fits your property. Your answers stay in your browser and nothing is sent anywhere.
  </p>

  <noscript>
    <p class="callout callout--caution" data-checker-noscript>
      This interactive scenario checker runs in your browser and needs JavaScript turned on. Without JavaScript, you can still check the household rules and indicative discount amounts in the summary below and on our linked Victoria rebate guides.
    </p>
  </noscript>

  <script type="application/json" id="figures" set:html={JSON.stringify(serializedFigures)} />
  <script type="application/json" id="veu-postcodes" set:html={JSON.stringify(compactPostcodes)} />
  <script type="application/json" id="checker-links" set:html={JSON.stringify(resolvedLinks)} />

  <p class="checker-progress" data-checker-progress aria-live="polite" style="font-size: var(--text-sm); color: var(--text-secondary);">
    Showing 8 questions for your selected upgrades.
  </p>

  <form data-checker-form novalidate>
    <div class="field-group" data-question-item>
      <label class="field-label" for="chk-q1">1. Where is the property located?</label>
      <select id="chk-q1" name="q1State" required>
        <option value="vic">Victoria</option>
        <option value="other">Another state or territory</option>
      </select>
    </div>

    <fieldset class="field-group" data-question-item aria-describedby="chk-q2-error">
      <legend class="field-label">2. What do you want to look at? (choose one or more)</legend>
      <div class="checkbox-list" style="display: grid; gap: 0.5rem; margin-top: 0.35rem;">
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="chk-q2-rcac" name="q2Activities" value="rcac" checked data-chk-activity />
          <span>Heating and cooling</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="chk-q2-hotwater" name="q2Activities" value="hotwater" data-chk-activity />
          <span>Hot water</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="chk-q2-insulation" name="q2Activities" value="insulation" data-chk-activity />
          <span>Ceiling insulation</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="chk-q2-induction" name="q2Activities" value="induction" data-chk-activity />
          <span>Induction cooktop</span>
        </label>
        <label style="display: flex; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="chk-q2-sealing" name="q2Activities" value="sealing" data-chk-activity />
          <span>Draught proofing</span>
        </label>
      </div>
      <p id="chk-q2-error" class="field-error" role="alert" hidden style="color: #b91c1c; font-size: var(--text-sm); margin-top: 0.35rem;">
        Choose at least one upgrade to check.
      </p>
    </fieldset>

    <div class="field-group" data-question-item>
      <label class="field-label" for="chk-q3">
        3. Have you already bought or installed the new system, or has work started?
      </label>
      <select id="chk-q3" name="q3WorkStage" required>
        <option value="no">No — not bought or installed yet</option>
        <option value="bought_not_installed">Bought, not installed</option>
        <option value="installed_or_started">Installed or work started</option>
      </select>
    </div>

    <div class="field-group" data-question-item>
      <label class="field-label" for="chk-q4">4. Is the property a home or a business?</label>
      <select id="chk-q4" name="q4PropertyType" required>
        <option value="home">Home (residential property)</option>
        <option value="business">Business or commercial premises</option>
      </select>
    </div>

    <div class="field-group" data-question-item>
      <label class="field-label" for="chk-q5">5. Do you own or rent?</label>
      <select id="chk-q5" name="q5Tenure" required>
        <option value="own">Own and live there</option>
        <option value="rent">Rent (tenant)</option>
        <option value="landlord">Landlord (rental property owner)</option>
      </select>
    </div>

    <div class="field-group" data-chk-age-group data-question-item>
      <label class="field-label" for="chk-q6">6. Is the building more than 2 years old?</label>
      <select id="chk-q6" name="q6BuildingOver2Years" required>
        <option value="yes">Yes — more than 2 years old</option>
        <option value="no">No — built within the last 2 years</option>
        <option value="not_sure">Not sure</option>
      </select>
    </div>

    <div data-chk-group="rcac">
      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q7a">7a. What heats the home now?</label>
        <select id="chk-q7a" name="q7aCurrentHeating">
          <option value="room-gas">Room (non-ducted) gas heater</option>
          <option value="ducted-gas">Ducted gas heater</option>
          <option value="central-electric">Central electric resistance ducted heater</option>
          <option value="hardwired-electric">Hard-wired electric room heater</option>
          <option value="ducted-rcac">Ducted reverse-cycle air conditioner</option>
          <option value="split-rcac">Split-system reverse-cycle air conditioner</option>
          <option value="none">Nothing or other (e.g. wood heater or plug-in portable)</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q7b">7b. What heating and cooling system would you like?</label>
        <select id="chk-q7b" name="q7bTargetHeating">
          <option value="split">Split system(s) (single or multi-split)</option>
          <option value="ducted">Ducted reverse-cycle system</option>
          <option value="not_sure">Not sure yet</option>
        </select>
      </div>
    </div>

    <div data-chk-group="hotwater" hidden>
      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q8a">8a. What is your current hot water system?</label>
        <select id="chk-q8a" name="q8aCurrentHotWater">
          <option value="mains-gas">Mains gas (storage or instantaneous)</option>
          <option value="electric">Electric storage water heater</option>
          <option value="lpg">Bottled LPG gas water heater</option>
          <option value="broken-solar">Solar water heater that no longer works</option>
          <option value="none">None (new connection without an existing heater)</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q8b">
          8b. How many hot water systems have already been upgraded through VEU at this address?
        </label>
        <select id="chk-q8b" name="q8bPreviousHotWaterUpgrades">
          <option value="0">0 (none upgraded yet)</option>
          <option value="1">1 system</option>
          <option value="2_plus">2 or more systems</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>
    </div>

    <div data-chk-group="insulation" hidden>
      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q9a">9a. What's the property's postcode?</label>
        <input
          type="text"
          id="chk-q9a"
          name="q9aPostcode"
          inputmode="numeric"
          pattern="3\d{3}"
          maxlength="4"
          autocomplete="postal-code"
          aria-describedby="chk-q9a-error"
        />
        <p id="chk-q9a-error" class="field-error" role="alert" hidden style="color: #b91c1c; font-size: var(--text-sm); margin-top: 0.35rem;">
          Enter a 4-digit Victorian postcode
        </p>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q9b">9b. What's in the ceiling now?</label>
        <select id="chk-q9b" name="q9bCeilingNow">
          <option value="none">No insulation</option>
          <option value="thin">Some, but thin (less than about 90 mm, or lower than the top of the ceiling joists)</option>
          <option value="thicker">Thicker than that</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q9c">
          9c. Are there halogen downlights in the ceiling, or any wiring you know is unsafe?
        </label>
        <select id="chk-q9c" name="q9cUnsafeCeiling">
          <option value="no">No</option>
          <option value="yes">Yes</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>
    </div>

    <div data-chk-group="induction" hidden>
      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q10a">10a. What cooktop do you have now?</label>
        <select id="chk-q10a" name="q10aCooktopNow">
          <option value="gas">Gas</option>
          <option value="electric">Electric (not induction)</option>
          <option value="induction">Induction already</option>
          <option value="none">None</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q10b">
          10b. Has an induction cooktop discount already been claimed at this address?
        </label>
        <select id="chk-q10b" name="q10bClaimedBefore">
          <option value="no">No</option>
          <option value="yes">Yes</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q10c">10c. What kind of induction cooktop do you want?</label>
        <select id="chk-q10c" name="q10cCooktopTarget">
          <option value="builtin_or_freestanding">Built-in or freestanding, at least 550 × 380 mm, 3 or more zones</option>
          <option value="portable">Portable</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>
    </div>

    <div data-chk-group="sealing" hidden>
      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q11a">11a. What kind of home is it?</label>
        <select id="chk-q11a" name="q11aHomeType">
          <option value="house">House</option>
          <option value="townhouse">Townhouse</option>
          <option value="apartment">Apartment</option>
        </select>
      </div>

      <div class="field-group" data-question-item>
        <label class="field-label" for="chk-q11b">
          11b. Is there an open-flued or flueless gas heater, or an open-flued gas water heater, inside the home?
        </label>
        <p id="chk-q11b-help" style="font-size: var(--text-sm); color: var(--text-secondary); margin: 0.15rem 0 0.35rem;">
          These are heaters and water heaters that take air from the room or release fumes into it. If you're not sure, choose 'Not sure'.
        </p>
        <select id="chk-q11b" name="q11bOpenFluedGas" aria-describedby="chk-q11b-help">
          <option value="no">No</option>
          <option value="yes">Yes</option>
          <option value="not_sure">Not sure</option>
        </select>
      </div>
    </div>

    <button type="submit" class="btn">Check indicative VEU discount</button>
  </form>

  <div data-checker-output class="callout callout--info" hidden aria-live="polite" tabindex="-1"></div>
</section>

<script src="./eligibility.client.ts"></script>
