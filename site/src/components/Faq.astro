---
import { renderFaqAnswerHtml } from '../lib/faq-markdown';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FaqItem[];
  heading?: string;
  pathname?: string;
}

const { items, heading = 'Frequently asked questions', pathname = Astro.url.pathname } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-list" aria-labelledby="faq-heading">
    <h2 id="faq-heading">{heading}</h2>
    {items.map((item) => (
      <div class="faq-item">
        <h3>{item.question}</h3>
        <p set:html={renderFaqAnswerHtml(item.answer, pathname)} />
      </div>
    ))}
  </section>
)}
