---
import { getCollection } from 'astro:content';
import { SITE } from '../data/site';
import { isUrlEnabled } from '../lib/rollout';

const isHome = Astro.url.pathname === '/';

const businessHubEnabled = isUrlEnabled('/victoria/business-energy-upgrades/');
const languageHelpEnabled = isUrlEnabled('/victoria/help-in-your-language/');

const allAreas = await getCollection('areas');
const enabledAreas = allAreas
  .filter((a) => !a.data.noindex && isUrlEnabled(`/victoria/${a.data.slug}/`))
  .sort((a, b) => a.data.mapRow - b.data.mapRow);

const areaGroups = [
  {
    id: 'melbourne-hubs',
    heading: 'Melbourne hubs',
    items: enabledAreas.filter((a) => a.data.areaGroup === 'melbourne-hubs'),
  },
  {
    id: 'regional',
    heading: 'Regional',
    items: enabledAreas.filter((a) => a.data.areaGroup === 'regional'),
  },
  {
    id: 'corridors-councils',
    heading: 'Corridors and councils',
    items: enabledAreas.filter((a) => a.data.areaGroup === 'corridors-councils'),
  },
].filter((g) => g.items.length > 0);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <h2>Victoria VEU Guides</h2>
      <ul>
        <li><a href="/">Victoria Rebates Overview</a></li>
        <li><a href="/victoria/air-conditioner-rebate/">Air Conditioner Rebate Victoria</a></li>
        <li><a href="/victoria/heat-pump-rebate/">Heat Pump Rebate Victoria</a></li>
        <li><a href="/victoria/gas-to-electric-hot-water-2027/">1 March 2027 Gas Hot Water Rule</a></li>
        <li><a href="/victoria/reverse-cycle-vs-gas-heater/">Reverse-Cycle vs Gas Heater Timing Rule</a></li>
        <li><a href="/victoria/eligibility-checker/">VEU Eligibility Checker</a></li>
      </ul>
    </div>
    {businessHubEnabled && (
      <div>
        <h2>Business</h2>
        <ul>
          <li><a href="/victoria/business-energy-upgrades/">Business Energy Upgrades</a></li>
        </ul>
      </div>
    )}
    <div>
      <h2>About & Consumer Rights</h2>
      <ul>
        <li><a href="/how-quotes-work/">How Quotes and Installers Work</a></li>
        <li><a href="/how-quotes-work/#your-rights">Your Rights Under the VEU Code</a></li>
        {languageHelpEnabled && (
          <li><a href="/victoria/help-in-your-language/">Help in your language</a></li>
        )}
        <li><a href="/faq/">Frequently Asked Questions</a></li>
        <li><a href="/sources/">Official Sources & Method</a></li>
        <li><a href="/about/">About {SITE.name}</a></li>
        <li><a href="/privacy/">Privacy Policy & Collection Notice</a></li>
        <li><a href="/terms/">Terms of Use</a></li>
      </ul>
    </div>
  </div>
  {areaGroups.length > 0 && (
    <div class="site-footer__areas" data-footer-areas>
      <h2>Areas covered</h2>
      <div class="site-footer__area-groups">
        {areaGroups.map((group) => (
          <div data-footer-area-group={group.id}>
            <h3>{group.heading}</h3>
            <ul>
              {group.items.map((area) => (
                <li>
                  <a href={`/victoria/${area.data.slug}/`}>{area.data.areaName}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )}
  <div class="site-footer__legal">
    <p>
      Published by <a href="https://www.agenorit.com.au" target="_blank" rel={isHome ? 'noopener' : 'nofollow noopener'}><strong>{SITE.publisher.legalName}</strong></a> (ABN {SITE.publisher.abn}), {SITE.publisher.location}.
      {SITE.name} is an independent publication and does not represent or work for the Victorian Energy Upgrades program, the Essential Services Commission (ESC), or the Victorian Government.
      All discount figures are indicative and sourced from official Energy Victoria publications. Eligibility and final discounts are confirmed by a VEU accredited provider before work begins.
    </p>
  </div>
</footer>
