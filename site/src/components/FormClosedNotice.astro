---
import { ensureTrailingSlash } from '../lib/urls';

const currentPath = ensureTrailingSlash(Astro.url.pathname);
const isCheckerPage = currentPath === '/victoria/eligibility-checker/';
---

<section class="form-card" id="quote-form" aria-labelledby="form-closed-heading">
  <h2 id="form-closed-heading">Quote requests are not open yet</h2>
  <p>
    We're not taking quote requests yet. To get a discount now, contact an accredited provider from Energy Victoria's list:
  </p>
  <ul>
    <li>
      <a
        href="https://www.energy.vic.gov.au/victorian-energy-upgrades/products/heating-and-cooling-discounts"
        target="_blank"
        rel="noopener noreferrer"
      >
        Energy Victoria — Heating and cooling discounts and providers ↗
      </a>
    </li>
    <li>
      <a
        href="https://www.energy.vic.gov.au/victorian-energy-upgrades/products/hot-water-system-discounts"
        target="_blank"
        rel="noopener noreferrer"
      >
        Energy Victoria — Hot water system discounts and providers ↗
      </a>
    </li>
  </ul>
  {!isCheckerPage && (
    <p>
      Not sure which scenario applies to your home? Try our{' '}
      <a href="/victoria/eligibility-checker/">Victoria VEU Eligibility Checker</a> first.
    </p>
  )}
</section>
