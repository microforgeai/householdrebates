---
import { SITE } from '../data/site';
import { isUrlEnabled } from '../lib/rollout';

const pathname = Astro.url.pathname;
const showBusiness = isUrlEnabled('/victoria/business-energy-upgrades/');
const showAreas = isUrlEnabled('/victoria/postcode/');

const navLinks = [
  {
    href: '/victoria/air-conditioner-rebate/',
    shortLabel: 'AC Rebate',
    fullLabel: 'Air Conditioner Rebate',
    wideOnly: false,
  },
  {
    href: '/victoria/heat-pump-rebate/',
    shortLabel: 'Heat Pump Rebate',
    fullLabel: 'Heat Pump Rebate',
    wideOnly: false,
  },
  {
    href: '/victoria/gas-to-electric-hot-water-2027/',
    shortLabel: '2027 Gas Rule',
    fullLabel: '2027 Gas Rule',
    wideOnly: false,
  },
  ...(showBusiness
    ? [
        {
          href: '/victoria/business-energy-upgrades/',
          shortLabel: 'Business',
          fullLabel: 'Business Upgrades',
          wideOnly: false,
        },
      ]
    : []),
  ...(showAreas
    ? [
        {
          href: '/victoria/postcode/',
          shortLabel: 'Areas',
          fullLabel: 'Areas & Postcodes',
          wideOnly: false,
        },
      ]
    : []),
  {
    href: '/how-quotes-work/',
    shortLabel: 'How Quotes Work',
    fullLabel: 'How Quotes Work',
    wideOnly: true,
  },
  {
    href: '/sources/',
    shortLabel: 'Sources',
    fullLabel: 'Sources',
    wideOnly: true,
  },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/">
      <svg
        class="site-brand__mark"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 10.5L12 3l9 7.5v8.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V10.5z" />
        <path d="M9 20V13h6v7" />
      </svg>
      <span>{SITE.name}</span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-wide={link.wideOnly ? 'true' : undefined}
          aria-current={pathname === link.href ? 'page' : undefined}
        >
          {link.shortLabel}
        </a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a
        href="/victoria/eligibility-checker/"
        class="nav-cta"
        aria-current={pathname === '/victoria/eligibility-checker/' ? 'page' : undefined}
      >
        Check eligibility
      </a>

      <details class="mobile-menu" data-mobile-menu>
        <summary class="mobile-menu__btn" data-mobile-menu-summary>
          <svg
            class="mobile-menu__icon mobile-menu__icon--open"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
          </svg>
          <svg
            class="mobile-menu__icon mobile-menu__icon--close"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
          <span class="mobile-menu__label">Menu</span>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Mobile navigation">
          <ul class="mobile-menu__list">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={pathname === link.href ? 'page' : undefined}
                >
                  <span>{link.fullLabel}</span>
                  <span class="mobile-menu__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
