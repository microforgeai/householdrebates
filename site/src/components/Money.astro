---
import { getEntry } from 'astro:content';
import { SITE } from '../data/site';
import { assertFigureNotStale, formatAuDate } from '../lib/dates';
import { assertValidBlockLabel, formatFigureAmount, KIND_TAGS } from '../lib/figures';

export interface Props {
  id: string;
  variant?: 'inline' | 'block';
  label?: string;
}

const { id, variant = 'inline', label } = Astro.props;
const entry = await getEntry('figures', id);
if (!entry) {
  throw new Error(`<Money id="${id}" /> references a figure ID that does not exist in figures collection.`);
}

const fig = entry.data;
assertFigureNotStale(fig.id, fig.checkedOn, SITE.flags.maxFigureAgeDays);

const sourceEntry = await getEntry(fig.sourceId);
if (!sourceEntry || !sourceEntry.data.official) {
  throw new Error(`Figure "${fig.id}" must reference an official source.`);
}

if (!fig.kind || !(fig.kind in KIND_TAGS)) {
  throw new Error(`Figure "${fig.id}" is missing a valid kind.`);
}

const isEstimate = fig.basis === 'estimate';
const validLabel = variant === 'block' ? assertValidBlockLabel(fig.id, label, isEstimate) : undefined;
const kindTag = KIND_TAGS[fig.kind];
const formattedAmount = formatFigureAmount(fig);
const checkedStr = formatAuDate(fig.checkedOn);
---

{variant === 'block' ? (
  <figure
    class="money-block"
    data-money-block
    data-figure={fig.id}
    data-figure-id={fig.id}
    data-figure-basis={fig.basis ?? 'official'}
    data-kind={fig.kind}
    data-money-label={validLabel}
  >
    <figcaption class="money-block__label" data-money-label>{validLabel}</figcaption>
    {fig.jurisdiction === 'federal' && (
      <span class="money-block__federal" data-money-federal>FEDERAL</span>
    )}
    <span class="money-block__kind" data-money-kind>{kindTag}</span>
    <span class="money-block__amount">{formattedAmount}</span>
    {isEstimate && (
      <span class="money-block__estimate-note">
        Our calculation from VEU Specifications v25.0, Part 48. The accredited provider confirms the amount.
      </span>
    )}
    <span class="money-block__meta">
      Checked on {checkedStr} ·{' '}
      <a href={sourceEntry.data.url} target="_blank" rel="noopener noreferrer">
        {sourceEntry.data.publisher} ↗
      </a>
    </span>
  </figure>
) : (
  <span
    class="money-inline"
    data-figure={fig.id}
    data-figure-id={fig.id}
    data-figure-basis={fig.basis ?? 'official'}
  >
    {formattedAmount}
    <sup class="money-inline__sup">
      <a
        href={sourceEntry.data.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Source: ${sourceEntry.data.publisher}, checked ${checkedStr}`}
        title={`Source: ${sourceEntry.data.title} (${sourceEntry.data.publisher}, checked ${checkedStr})`}
      >
        [source]
      </a>
    </sup>
  </span>
)}
