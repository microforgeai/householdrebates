---
export interface StepItem {
  name: string;
  text: string;
}

export interface Props {
  steps: StepItem[];
}

const { steps } = Astro.props;
---

<ol class="steps-list">
  {steps.map((step) => (
    <li class="steps-list__item">
      <strong>{step.name}.</strong> {step.text}
    </li>
  ))}
</ol>
