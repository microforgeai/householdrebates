---
export interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: HeadingItem[];
  mode?: 'desktop' | 'mobile';
}

const { headings, mode = 'desktop' } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{h2s.length >= 3 && mode === 'desktop' && (
  <aside class="toc-rail">
    <nav class="toc toc--desktop" aria-label="On this page">
      <p class="toc__title">On this page</p>
      <ol>
        {h2s.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>
)}

{h2s.length >= 3 && mode === 'mobile' && (
  <details class="toc-mobile" data-toc-mobile>
    <summary class="toc-mobile__summary">
      <span>On this page</span>
      <span class="toc-mobile__icon" aria-hidden="true"></span>
    </summary>
    <nav class="toc-mobile__nav" aria-label="On this page (mobile)">
      <ol>
        {h2s.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}
