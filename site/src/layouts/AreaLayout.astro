---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import AnswerText from '../components/AnswerText.astro';
import HeroBlock, { type HeroValue } from '../components/HeroBlock.astro';
import RuleStatusNotice from '../components/RuleStatusNotice.astro';
import Toc, { type HeadingItem } from '../components/Toc.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import SourceList from '../components/SourceList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Byline from '../components/Byline.astro';
import { formatAuDate } from '../lib/dates';
import { resolvePageFaqs } from '../lib/faqs';
import { entryToPathname, ensureTrailingSlash } from '../lib/urls';
import { getEnabledUrls } from '../lib/rollout';
import type { BreadcrumbItem } from '../lib/schema';
import postcodesJson from '../data/postcodes.json';

export interface Props {
  entry: {
    data: {
      title: string;
      h1?: string;
      description: string;
      slug: string;
      answer: string;
      hero?: HeroValue;
      author: string;
      publishedOn: Date;
      updatedOn: Date;
      checkedOn: Date;
      sources: (string | { id: string })[];
      figures: string[];
      faq: (string | { id: string })[];
      leadForm: false | 'rcac' | 'hotwater' | 'either';
      noindex: boolean;
      related: string[];
      areaName: string;
      variant?: 'standard' | 'multi-town';
      towns?: string[];
      councils?: string[];
      postcodes: string[];
      veuPostcodeTable?: boolean;
      nccZone?: { zone: number; places: string[] };
      nccZones?: { zone: number; places: string[] }[];
      localFacts: { text: string; sourceId: string | { id: string } }[];
      councilPrograms?: {
        name: string;
        operator?: string;
        status: 'open' | 'paused' | 'closing' | 'closed' | 'unverified';
        statusNote: string;
        statusCheckedOn: Date;
        sourceId: string | { id: string };
      }[];
      ruleStatus?: 'election-watch';
    };
  };
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
  headings?: HeadingItem[];
}

const { entry, pathname, breadcrumbs, headings = [] } = Astro.props;
const d = entry.data;

const { canonicalFaqs, linkedFaqs } = await resolvePageFaqs(pathname, d.faq ?? []);

const resolvedFacts = await Promise.all(
  d.localFacts.map(async (lf) => {
    const sId = typeof lf.sourceId === 'string' ? lf.sourceId : lf.sourceId.id;
    const s = await getEntry('sources', sId);
    return {
      text: lf.text,
      sourceTitle: s?.data.title ?? sId,
      sourcePublisher: s?.data.publisher ?? 'Official source',
      sourceUrl: s?.data.url ?? '#',
    };
  }),
);

const STATUS_LABELS: Record<'open' | 'paused' | 'closing' | 'closed', string> = {
  open: 'Open',
  paused: 'Paused',
  closing: 'Closing soon',
  closed: 'Closed',
};

const resolvedPrograms = await Promise.all(
  (d.councilPrograms ?? [])
    .filter((cp) => cp.status !== 'unverified')
    .map(async (cp) => {
      const sId = typeof cp.sourceId === 'string' ? cp.sourceId : cp.sourceId.id;
      const s = await getEntry('sources', sId);
      const status = cp.status as 'open' | 'paused' | 'closing' | 'closed';
      return {
        name: cp.name,
        operator: cp.operator,
        status,
        statusLabel: STATUS_LABELS[status],
        statusNote: cp.statusNote,
        statusCheckedStr: formatAuDate(cp.statusCheckedOn),
        statusCheckedIso: cp.statusCheckedOn.toISOString().slice(0, 10),
        sourcePublisher: s?.data.publisher ?? sId,
        sourceUrl: s?.data.url ?? '#',
      };
    }),
);

const postcodeRowsMap = postcodesJson.rows as Record<
  string,
  {
    area: string;
    reticulatedGas: boolean;
    climaticRegion: string;
    hpZone: number;
    localities?: string;
    localitiesList?: string[];
    primary_lga?: string;
    primary_lga_share_pct?: number | null;
    other_lgas?: { lga: string; pct: number }[];
  }
>;

function formatCouncilShare(row: {
  primary_lga?: string;
  primary_lga_share_pct?: number | null;
  other_lgas?: { lga: string; pct: number }[];
}): string {
  const primary = row.primary_lga ?? 'Unknown';
  if (row.primary_lga_share_pct === null || row.primary_lga_share_pct === undefined) {
    return `${primary} (PO box, indicative)`;
  }
  if (row.other_lgas && row.other_lgas.length > 0) {
    const others = row.other_lgas.map((o) => `${o.lga} ${o.pct}%`).join(', ');
    return `${primary} ${row.primary_lga_share_pct}% (${others})`;
  }
  return `${primary} (${row.primary_lga_share_pct}%)`;
}

const showPostcodeTable = d.veuPostcodeTable ?? true;
const isInitiallySortedByPostcode = d.postcodes.every(
  (pc, idx, arr) => idx === 0 || arr[idx - 1].localeCompare(pc) <= 0,
);
const postcodeTableRows = showPostcodeTable
  ? d.postcodes.map((pc) => {
      const row = postcodeRowsMap[pc];
      if (!row) {
        throw new Error(
          `Area "${d.slug}" lists postcode "${pc}" which is missing from src/data/postcodes.json`,
        );
      }
      const localitiesDisplay =
        row.localitiesList && row.localitiesList.length > 0
          ? row.localitiesList.join(', ')
          : (row.localities ?? '').replace(/;\s*/g, ', ');
      return {
        postcode: pc,
        ...row,
        localitiesDisplay,
        councilDisplay: formatCouncilShare(row),
      };
    })
  : [];

const nccZoneEntries = d.nccZones ?? (d.nccZone ? [d.nccZone] : []);
const abcbDataSource = nccZoneEntries.length > 0 ? await getEntry('sources', 'abcb-climate-zones-data') : null;
const abcbMapSource = nccZoneEntries.length > 0 ? await getEntry('sources', 'abcb-climate-map') : null;

const allInstallers = await getCollection('installers');
const coveringInstallers = allInstallers
  .map((i) => i.data)
  .filter(
    (i) =>
      i.active &&
      i.agreementSignedOn &&
      i.postcodes.some((pc) => d.postcodes.includes(pc)),
  );

const enabledUrls = getEnabledUrls();
const allAreas = await getCollection('areas', (a) => a.data.state === 'vic');
const otherAreas = allAreas
  .filter((a) => a.data.slug !== d.slug && enabledUrls.has(entryToPathname('areas', a.data)))
  .sort((a, b) => a.data.mapRow - b.data.mapRow)
  .map((a) => ({
    url: entryToPathname('areas', a.data),
    title: a.data.title,
    areaName: a.data.areaName,
  }));

const hasToc = headings.filter((h) => h.depth === 2).length >= 3;
const contextSubLabel =
  d.variant === 'multi-town' && d.towns && d.towns.length > 0
    ? d.towns.join(', ')
    : d.councils && d.councils.length > 0
      ? d.councils.join(', ')
      : '';
const isCheckerPage = ensureTrailingSlash(pathname) === '/victoria/eligibility-checker/';
---

<BaseLayout
  title={d.title}
  description={d.description}
  pathname={pathname}
  noindex={d.noindex}
  breadcrumbs={breadcrumbs}
  faqs={canonicalFaqs}
  ruleStatus={d.ruleStatus}
  pageSchema={{
    kind: 'area',
    headline: d.h1 ?? d.title,
    description: d.description,
    publishedOn: d.publishedOn,
    updatedOn: d.updatedOn,
  }}
>
  <Breadcrumbs items={breadcrumbs} />
  <div class={hasToc ? 'page-grid page-grid--with-toc' : 'page-grid'}>
    <article class="prose-container">
      <h1>{d.h1 ?? d.title}</h1>
      <AnswerBlock>
        <AnswerText text={d.answer} />
        <HeroBlock hero={d.hero} />
      </AnswerBlock>
      {d.ruleStatus === 'election-watch' && <RuleStatusNotice />}
      <Byline
        author={d.author}
        checkedOn={d.checkedOn}
        updatedOn={d.updatedOn}
        pathname={pathname}
      />

      <section class="callout callout--info" aria-labelledby="local-facts-heading">
        <strong class="callout__title" id="local-facts-heading">
          Local context for {d.areaName}{contextSubLabel ? ` (${contextSubLabel})` : ''}
        </strong>
        <p style="font-size:var(--text-sm);">
          <strong>Postcodes covered on this page:</strong> {d.postcodes.join(', ')}
        </p>
        <ul>
          {resolvedFacts.map((fact) => (
            <>
              {'\n'}
              <li data-local-fact>
                {fact.text}{' '}
                <a href={fact.sourceUrl} target="_blank" rel="noopener noreferrer">
                  [{fact.sourcePublisher}]
                </a>
              </li>
            </>
          ))}
        </ul>
      </section>

      {showPostcodeTable && postcodeTableRows.length > 0 && (
        <section data-postcode-table aria-labelledby="veu-postcode-table-heading">
          <h2 id="veu-postcode-table-heading">VEU postcode classification for {d.areaName}</h2>
          <div class="figure-table-wrap">
            <table class="figure-table postcode-table">
              <caption>
                Source: VEU Specifications v{postcodesJson.specVersion}, Location Variable List (Table A), with localities and 2021 Census dwelling council shares from ABS ASGS Edition 3 allocation files. Checked{' '}
                {formatAuDate(new Date(postcodesJson.checkedOn))}. Select any column heading to sort.
              </caption>
              <thead>
                <tr>
                  <th scope="col" aria-sort={isInitiallySortedByPostcode ? 'ascending' : 'none'}>
                    <button type="button" class="postcode-sort-btn" data-sort-col="0">Postcode</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="1">Localities</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="2">Council share</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="3">VEU area</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="4">Reticulated gas</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="5">Climatic region</button>
                  </th>
                  <th scope="col" aria-sort="none">
                    <button type="button" class="postcode-sort-btn" data-sort-col="6">Heat pump zone</button>
                  </th>
                </tr>
              </thead>
              <tbody>
                {postcodeTableRows.map((r) => (
                  <tr data-postcode={r.postcode}>
                    <td>{r.postcode}</td>
                    <td>{r.localitiesDisplay}</td>
                    <td>{r.councilDisplay}</td>
                    <td>{r.area}</td>
                    <td>{r.reticulatedGas ? 'Yes' : 'No'}</td>
                    <td>{r.climaticRegion}</td>
                    <td>Zone {r.hpZone}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {nccZoneEntries.length > 0 && (
        <section class="callout callout--info" aria-labelledby="ncc-zone-heading">
          <strong class="callout__title" id="ncc-zone-heading">
            {nccZoneEntries.length === 1
              ? `National Construction Code (NCC) climate zone ${nccZoneEntries[0].zone}`
              : `National Construction Code (NCC) climate zones ${nccZoneEntries.map((z) => z.zone).join(' and ')}`}
          </strong>
          <p style="font-size: var(--text-sm); margin-bottom: 0.35rem;">
            {nccZoneEntries.length === 1
              ? `Point checks at ${nccZoneEntries[0].places.join(', ')} fall in NCC climate zone ${nccZoneEntries[0].zone}.`
              : `Point checks fall in ${nccZoneEntries.map((z) => `NCC climate zone ${z.zone} at ${z.places.join(', ')}`).join('; and ')}.`}{' '}
            Confirm your exact street or postcode on the{' '}
            <a
              href={abcbMapSource?.data.url ?? 'https://www.abcb.gov.au/abcb-climate-map'}
              target="_blank"
              rel="noopener noreferrer"
            >
              ABCB Climate Map ↗
            </a>.
          </p>
          <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-bottom: 0;">
            Attribution: {abcbDataSource?.data.attribution ?? 'Australian Building Codes Board (ABCB), CC BY 4.0.'}{' '}
            <a
              href={abcbDataSource?.data.url ?? 'https://data.gov.au/data/dataset/australian-climate-zone-map'}
              target="_blank"
              rel="noopener noreferrer"
            >
              Dataset ↗
            </a>
          </p>
        </section>
      )}

      {resolvedPrograms.length > 0 && (
        <section class="callout callout--info" aria-labelledby="council-programs-heading">
          <strong class="callout__title" id="council-programs-heading">
            Council and regional energy programs
          </strong>
          <ul style="margin-bottom: 0;">
            {resolvedPrograms.map((prog) => (
              <li
                data-council-program={prog.name}
                data-program-status={prog.status}
                data-status-checked-on={prog.statusCheckedIso}
                style="margin-bottom: 0.5rem;"
              >
                <strong>{prog.name}</strong>
                {prog.operator ? ` (${prog.operator})` : ''} —{' '}
                <strong>Status: {prog.statusLabel}.</strong> {prog.statusNote}{' '}
                <span style="font-size: var(--text-xs); color: var(--text-secondary);">
                  Status checked {prog.statusCheckedStr} ·{' '}
                  <a href={prog.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {prog.sourcePublisher} ↗
                  </a>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="page-body" data-body>
        <slot />
      </div>

      <section aria-labelledby="area-installers-heading">
        <h2 id="area-installers-heading">Participating installers covering {d.areaName}</h2>
        {coveringInstallers.length > 0 ? (
          <ul>
            {coveringInstallers.map((inst) => (
              <li>
                <strong>{inst.tradingName}</strong> (ABN {inst.abn}) — works with VEU accredited provider{' '}
                <strong>{inst.accreditedProvider}</strong>. {inst.publicBlurb}
              </li>
            ))}
          </ul>
        ) : (
          <p>
            We do not yet have a signed partner installer covering {d.areaName} postcodes. Until partner agreements for this area are finalised, you can search Energy Victoria's official accredited provider directory directly or check your upgrade scenario with our{' '}
            <a href="/victoria/eligibility-checker/">Victoria Eligibility Checker</a>.
          </p>
        )}
      </section>

      <Faq items={canonicalFaqs} linkedItems={linkedFaqs} pathname={pathname} />

      {d.leadForm !== false && coveringInstallers.length > 0 ? (
        <LeadForm activity={d.leadForm} areaSlug={d.slug} />
      ) : d.leadForm !== false ? (
        <LeadForm activity="either" areaSlug={d.slug} />
      ) : (
        !isCheckerPage && (
          <section class="form-card" aria-labelledby="area-checker-cta">
            <h2 id="area-checker-cta">Check your {d.areaName} upgrade scenario</h2>
            <p>
              Enter your postcode and existing appliances in our Victoria Eligibility Checker to see which VEU scenarios and co-payments apply.
            </p>
            <a class="btn" href="/victoria/eligibility-checker/">Open the Victoria Eligibility Checker</a>
          </section>
        )
      )}

      <SourceList ids={d.sources} />
      <RelatedLinks pathname={pathname} slugs={d.related} />

      {otherAreas.length > 0 && (
        <nav class="related-links" aria-labelledby="other-areas-heading">
          <h2 id="other-areas-heading">Other areas in Victoria</h2>
          <ul>
            {otherAreas.map((area) => (
              <li>
                <a href={area.url}>{area.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </article>

    {hasToc && <Toc headings={headings} />}
  </div>
  {showPostcodeTable && postcodeTableRows.length > 0 && (
    <script src="../components/postcode-table.client.ts"></script>
  )}
</BaseLayout>
