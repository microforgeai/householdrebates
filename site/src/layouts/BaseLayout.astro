---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import IndependenceNotice from '../components/IndependenceNotice.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  buildJsonLdGraph,
  type BreadcrumbItem,
  type FaqSchemaItem,
  type HowToSchemaInput,
  type PageSchemaInput,
} from '../lib/schema';
import type { OgKind } from '../lib/seo';

export interface Props {
  title: string;
  description: string;
  pathname: string;
  noindex?: boolean;
  ogKind?: OgKind;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqSchemaItem[];
  howTo?: HowToSchemaInput;
  ruleStatus?: 'election-watch';
  pageSchema?: PageSchemaInput;
}

const {
  title,
  description,
  pathname,
  noindex = false,
  ogKind = 'default',
  breadcrumbs = [],
  faqs = [],
  howTo,
  ruleStatus,
  pageSchema,
} = Astro.props;

const schemaGraph = buildJsonLdGraph({
  pathname,
  breadcrumbs,
  faqs,
  howTo,
  pageSchema: pageSchema ? { ...pageSchema, ogKind: pageSchema.ogKind ?? ogKind } : undefined,
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <Seo
      title={title}
      description={description}
      pathname={pathname}
      noindex={noindex}
      ogKind={ogKind}
    />
    <JsonLd graph={schemaGraph} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <IndependenceNotice />
    <Header />
    <main id="main-content" data-rule-status={ruleStatus}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
