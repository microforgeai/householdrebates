---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import AnswerText from '../components/AnswerText.astro';
import HeroBlock, { type HeroValue } from '../components/HeroBlock.astro';
import RuleStatusNotice from '../components/RuleStatusNotice.astro';
import AlertSignup from '../components/AlertSignup.astro';
import Toc, { type HeadingItem } from '../components/Toc.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import LeadForm from '../components/LeadForm.astro';
import SourceList from '../components/SourceList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Byline from '../components/Byline.astro';
import { resolvePageFaqs } from '../lib/faqs';
import { hasVicElectionFigure, isElectionBannerPending } from '../lib/rule-status';
import { ensureTrailingSlash } from '../lib/urls';
import type { BreadcrumbItem, PageSchemaKind } from '../lib/schema';

export interface Props {
  entry: {
    data: {
      title: string;
      h1?: string;
      description: string;
      slug: string;
      navGroup?: string;
      answer: string;
      hero?: HeroValue;
      author: string;
      publishedOn: Date;
      updatedOn: Date;
      checkedOn: Date;
      sources: (string | { id: string })[];
      figures: string[];
      faq: (string | { id: string })[];
      howTo?: { name: string; steps: { name: string; text: string }[] };
      leadForm: false | 'rcac' | 'hotwater' | 'either';
      alertSignup?: boolean;
      noindex: boolean;
      related: string[];
      ruleStatus?: 'election-watch';
    };
  };
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
  headings?: HeadingItem[];
  variant?: 'default' | 'hub';
}

const {
  entry,
  pathname,
  breadcrumbs,
  headings = [],
  variant = 'default',
} = Astro.props;
const d = entry.data;

const { canonicalFaqs, linkedFaqs } = await resolvePageFaqs(pathname, d.faq ?? []);
const hasToc = variant !== 'hub' && headings.filter((h) => h.depth === 2).length >= 3;
const heroValue = variant === 'hub' ? false : d.hero;
const cleanPath = ensureTrailingSlash(pathname);
const isCheckerPage = cleanPath === '/victoria/eligibility-checker/';
const schemaKind: PageSchemaKind =
  variant === 'hub' || cleanPath === '/'
    ? 'hub'
    : cleanPath === '/faq/'
      ? 'trust'
      : 'guide';

const figIdSet = new Set(d.figures ?? []);
const matchedFigs =
  figIdSet.size > 0 ? await getCollection('figures', (f) => figIdSet.has(f.id)) : [];
const showRuleStatusNotice =
  d.ruleStatus === 'election-watch' ||
  (isElectionBannerPending() && hasVicElectionFigure(matchedFigs.map((f) => f.data.program)));
---

<BaseLayout
  title={d.title}
  description={d.description}
  pathname={pathname}
  noindex={d.noindex}
  breadcrumbs={breadcrumbs}
  faqs={canonicalFaqs}
  howTo={d.howTo}
  ruleStatus={d.ruleStatus}
  pageSchema={{
    kind: schemaKind,
    headline: d.h1 ?? d.title,
    description: d.description,
    publishedOn: d.publishedOn,
    updatedOn: d.updatedOn,
  }}
>
  <Breadcrumbs items={breadcrumbs} />
  <div class={hasToc ? 'page-grid page-grid--with-toc' : 'page-grid'}>
    <article class="prose-container">
      <h1>{d.h1 ?? d.title}</h1>
      <AnswerBlock>
        <AnswerText text={d.answer} />
        <HeroBlock hero={heroValue} />
      </AnswerBlock>
      {showRuleStatusNotice && <RuleStatusNotice checkedOn={d.checkedOn} />}
      <Byline
        author={d.author}
        checkedOn={d.checkedOn}
        updatedOn={d.updatedOn}
        pathname={pathname}
      />
      {d.alertSignup && <AlertSignup placement="guide" />}

      {d.howTo && (
        <section aria-labelledby="howto-heading">
          <h2 id="howto-heading">{d.howTo.name}</h2>
          <Steps steps={d.howTo.steps} />
        </section>
      )}

      <div class="page-body" data-body>
        <slot />
      </div>

      <Faq items={canonicalFaqs} linkedItems={linkedFaqs} pathname={pathname} />

      {d.leadForm !== false ? (
        <LeadForm activity={d.leadForm} />
      ) : (
        !isCheckerPage && (
          <section class="form-card" aria-labelledby="checker-cta-heading">
            <h2 id="checker-cta-heading">
              {d.navGroup === 'business'
                ? 'Check which VEU scenario fits your business'
                : 'Check which VEU scenario fits your home'}
            </h2>
            <p>
              {d.navGroup === 'business'
                ? 'Use the Business path in our Victoria Eligibility Checker to check commercial heating and cooling, LED lighting, cold rooms, hot water, motors, solar PV, and minimum co-payments.'
                : 'Use our Victoria Eligibility Checker to see whether heating and cooling, hot water, ceiling insulation, an induction cooktop, or draught proofing fits the current VEU household rules.'}
            </p>
            <a class="btn" href="/victoria/eligibility-checker/">Open the Victoria Eligibility Checker</a>
          </section>
        )
      )}

      <SourceList ids={d.sources} />
      {variant !== 'hub' && <RelatedLinks pathname={pathname} slugs={d.related} />}
    </article>

    {hasToc && <Toc headings={headings} />}
  </div>
</BaseLayout>
