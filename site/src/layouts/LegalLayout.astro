---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import AnswerText from '../components/AnswerText.astro';
import SourceList from '../components/SourceList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Byline from '../components/Byline.astro';
import type { BreadcrumbItem } from '../lib/schema';

export interface Props {
  entry: {
    data: {
      title: string;
      h1?: string;
      description: string;
      slug: string;
      answer: string;
      author: string;
      publishedOn: Date;
      updatedOn: Date;
      checkedOn: Date;
      sources: (string | { id: string })[];
      noindex: boolean;
      related: string[];
      legalReviewed: boolean;
    };
  };
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
}

const { entry, pathname, breadcrumbs } = Astro.props;
const d = entry.data;
const sourceIds =
  d.slug === 'sources'
    ? (await getCollection('sources')).map((s) => s.id).sort()
    : d.sources;
---

<BaseLayout
  title={d.title}
  description={d.description}
  pathname={pathname}
  noindex={d.noindex}
  ogKind="default"
  breadcrumbs={breadcrumbs}
  pageSchema={{
    kind: 'trust',
    headline: d.h1 ?? d.title,
    description: d.description,
    publishedOn: d.publishedOn,
    updatedOn: d.updatedOn,
  }}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="prose-container">
    <h1>{d.h1 ?? d.title}</h1>
    <AnswerBlock>
      <AnswerText text={d.answer} />
    </AnswerBlock>
    <Byline
      author={d.author}
      checkedOn={d.checkedOn}
      updatedOn={d.updatedOn}
      pathname={pathname}
      variant="short"
    />

    <div class="page-body" data-body>
      <slot />
    </div>

    <SourceList ids={sourceIds} />
    <RelatedLinks pathname={pathname} slugs={d.related} />
  </article>
</BaseLayout>
