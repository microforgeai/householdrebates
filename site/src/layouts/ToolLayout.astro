---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import Money from '../components/Money.astro';
import EligibilityChecker from '../components/EligibilityChecker.astro';
import RunningCostsPicker from '../components/RunningCostsPicker.astro';
import HwSizeGuide from '../components/HwSizeGuide.astro';
import GasExitPlanner from '../components/GasExitPlanner.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import SourceList from '../components/SourceList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { formatAuDate } from '../lib/dates';
import type { BreadcrumbItem } from '../lib/schema';

export interface Props {
  entry: {
    data: {
      title: string;
      description: string;
      slug: string;
      answer: string;
      author: string;
      publishedOn: Date;
      updatedOn: Date;
      checkedOn: Date;
      sources: (string | { id: string })[];
      figures: string[];
      faq: (string | { id: string })[];
      leadForm?: false | 'rcac' | 'hotwater' | 'either';
      noindex: boolean;
      related: string[];
    };
  };
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
}

const { entry, pathname, breadcrumbs } = Astro.props;
const d = entry.data;

const faqEntries = await Promise.all(
  (d.faq ?? []).map(async (ref) => {
    const id = typeof ref === 'string' ? ref : ref.id;
    const f = await getEntry('faqs', id);
    return f ? { question: f.data.question, answer: f.data.answer } : null;
  }),
);
const validFaqs = faqEntries.filter((f): f is { question: string; answer: string } => Boolean(f));
---

<BaseLayout
  title={`${d.title} | Household Rebates`}
  description={d.description}
  pathname={pathname}
  noindex={d.noindex}
  breadcrumbs={breadcrumbs}
  faqs={validFaqs}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="prose-container">
    <h1>{d.title}</h1>
    <AnswerBlock>
      <p>{d.answer}</p>
      {d.figures[0] && (
        <div>
          <Money id={d.figures[0]} variant="block" />
        </div>
      )}
    </AnswerBlock>
    <div class="byline">
      By {d.author}, Agenor · Figures checked on {formatAuDate(d.checkedOn)} against official Victorian sources · Updated{' '}
      {formatAuDate(d.updatedOn)}
    </div>

    {d.slug === 'eligibility-checker' && <EligibilityChecker state="vic" />}
    {d.slug === 'gas-vs-heat-pump-running-costs' && <RunningCostsPicker />}
    {d.slug === 'heat-pump-hot-water-size-guide' && <HwSizeGuide />}
    {d.slug === 'get-off-gas-planner' && <GasExitPlanner />}

    <div class="page-body" data-body>
      <slot />
    </div>

    {typeof d.leadForm === 'string' ? (
      <LeadForm activity={d.leadForm} />
    ) : (
      d.slug !== 'eligibility-checker' && (
        <section class="form-card" aria-labelledby="tool-checker-cta">
          <h2 id="tool-checker-cta">Check your household eligibility</h2>
          <p>
            Run our Victoria Eligibility Checker to see which VEU discount scenarios and minimum co-payments fit your property.
          </p>
          <a class="btn" href="/victoria/eligibility-checker/">Open the Victoria Eligibility Checker</a>
        </section>
      )
    )}

    <Faq items={validFaqs} />
    <SourceList ids={d.sources} />
    <RelatedLinks pathname={pathname} slugs={d.related} />
  </article>
</BaseLayout>
