---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import AnswerText from '../components/AnswerText.astro';
import HeroBlock, { type HeroValue } from '../components/HeroBlock.astro';
import RuleStatusNotice from '../components/RuleStatusNotice.astro';
import EligibilityChecker from '../components/EligibilityChecker.astro';
import PostcodeLookup from '../components/PostcodeLookup.astro';
import RunningCostsPicker from '../components/RunningCostsPicker.astro';
import HwSizeGuide from '../components/HwSizeGuide.astro';
import GasExitPlanner from '../components/GasExitPlanner.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import SourceList from '../components/SourceList.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getCheckerReferencedFigureIds } from '../lib/checker/rules';
import { formatAuDate } from '../lib/dates';
import { resolvePageFaqs } from '../lib/faqs';
import { ensureTrailingSlash } from '../lib/urls';
import type { BreadcrumbItem, HowToSchemaInput } from '../lib/schema';

export interface Props {
  entry: {
    data: {
      title: string;
      h1?: string;
      description: string;
      slug: string;
      answer: string;
      hero?: HeroValue;
      author: string;
      publishedOn: Date;
      updatedOn: Date;
      checkedOn: Date;
      sources: (string | { id: string })[];
      figures: string[];
      faq: (string | { id: string })[];
      howTo?: HowToSchemaInput;
      leadForm?: false | 'rcac' | 'hotwater' | 'either';
      noindex: boolean;
      related: string[];
      ruleStatus?: 'election-watch';
    };
  };
  pathname: string;
  breadcrumbs: BreadcrumbItem[];
}

const { entry, pathname, breadcrumbs } = Astro.props;
const d = entry.data;

const { canonicalFaqs, linkedFaqs } = await resolvePageFaqs(pathname, d.faq ?? []);
const isCheckerPage = ensureTrailingSlash(pathname) === '/victoria/eligibility-checker/';

let effectiveCheckedOn: Date = d.checkedOn;
if (isCheckerPage) {
  const checkerFigIds = new Set(getCheckerReferencedFigureIds());
  const checkerFigures = await getCollection('figures', (f) => checkerFigIds.has(f.id));
  for (const fig of checkerFigures) {
    if (fig.data.checkedOn.getTime() < effectiveCheckedOn.getTime()) {
      effectiveCheckedOn = fig.data.checkedOn;
    }
  }
}
---

<BaseLayout
  title={d.title}
  description={d.description}
  pathname={pathname}
  noindex={d.noindex}
  breadcrumbs={breadcrumbs}
  faqs={canonicalFaqs}
  howTo={d.howTo}
  ruleStatus={d.ruleStatus}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="prose-container">
    <h1>{d.h1 ?? d.title}</h1>
    <AnswerBlock>
      <AnswerText text={d.answer} />
      <HeroBlock hero={d.hero} />
    </AnswerBlock>
    {d.ruleStatus === 'election-watch' && <RuleStatusNotice />}
    <div class="byline">
      By {d.author}, Agenor · Figures checked on {formatAuDate(effectiveCheckedOn)} against official Victorian sources · Updated{' '}
      {formatAuDate(d.updatedOn)}
    </div>

    {d.slug === 'eligibility-checker' && <EligibilityChecker state="vic" />}
    {d.slug === 'postcode' && <PostcodeLookup />}
    {d.slug === 'gas-vs-heat-pump-running-costs' && <RunningCostsPicker />}
    {d.slug === 'heat-pump-hot-water-size-guide' && <HwSizeGuide />}
    {d.slug === 'get-off-gas-planner' && <GasExitPlanner />}

    <div class="page-body" data-body>
      <slot />
    </div>

    {typeof d.leadForm === 'string' ? (
      <LeadForm activity={d.leadForm} />
    ) : (
      !isCheckerPage && (
        <section class="form-card" aria-labelledby="tool-checker-cta">
          <h2 id="tool-checker-cta">Check your household eligibility</h2>
          <p>
            Run our Victoria Eligibility Checker to see which VEU discount scenarios and minimum co-payments fit your property.
          </p>
          <a class="btn" href="/victoria/eligibility-checker/">Open the Victoria Eligibility Checker</a>
        </section>
      )
    )}

    <Faq items={canonicalFaqs} linkedItems={linkedFaqs} pathname={pathname} />
    <SourceList ids={d.sources} />
    <RelatedLinks pathname={pathname} slugs={d.related} />
  </article>
</BaseLayout>
