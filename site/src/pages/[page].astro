---
import { getCollection, getEntry, render } from 'astro:content';
import GuideLayout from '../layouts/GuideLayout.astro';
import LegalLayout from '../layouts/LegalLayout.astro';
import Money from '../components/Money.astro';
import FigureTable from '../components/FigureTable.astro';
import Callout from '../components/Callout.astro';
import SourceLink from '../components/SourceLink.astro';
import HubIndex from '../components/HubIndex.astro';
import LinkIfEnabled from '../components/LinkIfEnabled.astro';
import { assertEntryEnabled } from '../lib/rollout';

export async function getStaticPaths() {
  const allPages = await getCollection('pages');
  const rootPages = allPages.filter(
    (p) =>
      p.data.slug !== 'home' &&
      p.data.slug !== 'victoria' &&
      !(p.data.state === 'vic' && p.data.section === 'tools'),
  );
  for (const p of rootPages) {
    assertEntryEnabled(p.data.mapRow, `/${p.data.slug}/`);
  }
  return rootPages.map((p) => ({
    params: { page: p.data.slug },
    props: { id: p.id },
  }));
}

const { page } = Astro.params;
const { id } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) {
  throw new Error(`Missing page entry "${id}"`);
}

const pathname = `/${page}/`;
const { Content, headings } = await render(entry);
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: entry.data.title, path: pathname },
];

const isLegalOrTrust =
  entry.data.slug === 'privacy' ||
  entry.data.slug === 'terms' ||
  entry.data.slug === 'about' ||
  entry.data.slug === 'sources';

const mdxComponents = { Money, FigureTable, Callout, SourceLink, HubIndex, LinkIfEnabled };
---

{isLegalOrTrust ? (
  <LegalLayout entry={entry} pathname={pathname} breadcrumbs={breadcrumbs}>
    <Content components={mdxComponents} />
  </LegalLayout>
) : (
  <GuideLayout entry={entry} pathname={pathname} breadcrumbs={breadcrumbs} headings={headings}>
    <Content components={mdxComponents} />
  </GuideLayout>
)}
