---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Email Alerts Confirmed"
  description="Your email address is confirmed for Victorian energy rebate rule-change updates from Household Rebates. You can unsubscribe from any email."
  pathname="/alerts/confirmed/"
  noindex={true}
>
  <article class="prose-container">
    <h1>Email alerts confirmed</h1>
    <p>
      Your email address is confirmed, and we will only email you when official Victorian energy rebate rules change.
    </p>
    <p>
      <a class="btn" href="/victoria/">Browse Victorian energy rebates</a>
    </p>
  </article>
</BaseLayout>
