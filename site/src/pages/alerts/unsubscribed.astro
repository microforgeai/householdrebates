---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Unsubscribed from Alerts"
  description="You have been unsubscribed from Household Rebates rule-change email alerts, and your address will not receive further update notifications."
  pathname="/alerts/unsubscribed/"
  noindex={true}
>
  <article class="prose-container">
    <h1>You're unsubscribed</h1>
    <p>
      You have been unsubscribed from rule-change email alerts and will not receive further update emails from us.
    </p>
    <p>
      <a class="btn" href="/victoria/">Browse Victorian energy rebates</a>
    </p>
  </article>
</BaseLayout>
