---
import { getEntry, render } from 'astro:content';
import HomeLayout from '../layouts/HomeLayout.astro';
import Money from '../components/Money.astro';
import Callout from '../components/Callout.astro';
import Steps from '../components/Steps.astro';
import VeuFlowDiagram from '../components/diagrams/VeuFlowDiagram.astro';
import { assertEntryEnabled } from '../lib/rollout';

const entry = await getEntry('pages', 'home');
if (!entry) {
  throw new Error('Missing content/pages/home.mdx');
}

assertEntryEnabled(entry.data.mapRow, '/');

const { Content } = await render(entry);
---

<HomeLayout entry={entry}>
  <Content components={{ Money, Callout, Steps, VeuFlowDiagram }} />
</HomeLayout>
