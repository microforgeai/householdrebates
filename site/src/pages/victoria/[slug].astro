---
import { getCollection, getEntry, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import AreaLayout from '../../layouts/AreaLayout.astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import Money from '../../components/Money.astro';
import FigureTable from '../../components/FigureTable.astro';
import Callout from '../../components/Callout.astro';
import SourceLink from '../../components/SourceLink.astro';
import HubIndex from '../../components/HubIndex.astro';
import LinkIfEnabled from '../../components/LinkIfEnabled.astro';
import { assertEntryEnabled, isUrlEnabled } from '../../lib/rollout';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.state === 'vic');
  const areas = await getCollection('areas', (a) => a.data.state === 'vic');
  const toolPages = await getCollection(
    'pages',
    (p) => p.data.state === 'vic' && p.data.section === 'tools',
  );

  const paths: {
    params: { slug: string };
    props: { kind: 'guide' | 'area' | 'tool'; id: string };
  }[] = [];

  for (const g of guides) {
    const url = `/victoria/${g.data.slug}/`;
    assertEntryEnabled(g.data.mapRow, url);
    paths.push({
      params: { slug: g.data.slug },
      props: { kind: 'guide', id: g.id },
    });
  }

  for (const a of areas) {
    const url = `/victoria/${a.data.slug}/`;
    assertEntryEnabled(a.data.mapRow, url);
    paths.push({
      params: { slug: a.data.slug },
      props: { kind: 'area', id: a.id },
    });
  }

  for (const t of toolPages) {
    const url = `/victoria/${t.data.slug}/`;
    assertEntryEnabled(t.data.mapRow, url);
    paths.push({
      params: { slug: t.data.slug },
      props: { kind: 'tool', id: t.id },
    });
  }

  return paths;
}

const { slug } = Astro.params;
const { kind, id } = Astro.props;
const pathname = `/victoria/${slug}/`;

let entry: any;
if (kind === 'guide') {
  entry = await getEntry('guides', id);
} else if (kind === 'area') {
  entry = await getEntry('areas', id);
} else {
  entry = await getEntry('pages', id);
}

if (!entry) {
  throw new Error(`Missing entry for /victoria/${slug}/`);
}

const { Content, headings } = await render(entry);
const hubEnabled = isUrlEnabled('/victoria/');
const breadcrumbs = hubEnabled
  ? [
      { name: 'Home', path: '/' },
      { name: 'Victoria', path: '/victoria/' },
      { name: entry.data.title, path: pathname },
    ]
  : [
      { name: 'Home', path: '/' },
      { name: entry.data.title, path: pathname },
    ];

const mdxComponents = { Money, FigureTable, Callout, SourceLink, HubIndex, LinkIfEnabled };
---

{kind === 'guide' && (
  <GuideLayout entry={entry} pathname={pathname} breadcrumbs={breadcrumbs} headings={headings}>
    <Content components={mdxComponents} />
  </GuideLayout>
)}

{kind === 'area' && (
  <AreaLayout entry={entry} pathname={pathname} breadcrumbs={breadcrumbs} headings={headings}>
    <Content components={mdxComponents} />
  </AreaLayout>
)}

{kind === 'tool' && (
  <ToolLayout entry={entry} pathname={pathname} breadcrumbs={breadcrumbs}>
    <Content components={mdxComponents} />
  </ToolLayout>
)}
